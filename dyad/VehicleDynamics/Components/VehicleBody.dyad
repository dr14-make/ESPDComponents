component VehicleBody
  contact_front = ESPDComponents.VehicleDynamics.Connectors.WheelContact() [{
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 200, "y1": 450, "x2": 300, "y2": 550, "rot": 0}
      }
    }
  }]

  contact_rear = ESPDComponents.VehicleDynamics.Connectors.WheelContact() [{
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 700, "y1": 450, "x2": 800, "y2": 550, "rot": 0}
      }
    }
  }]

  parameter m::Mass = 1500.0
  parameter L::Length = 2.7
  parameter h_cg::Length = 0.5
  parameter a::Length = 1.2
  parameter b::Length = 1.5
  parameter Cd::Real = 0.32
  parameter A::Area = 2.2
  parameter rho::Density = 1.225
  parameter Crr::Real = 0.015
  parameter g::Acceleration = 9.81
  parameter theta::Angle = 0.0
  parameter v_eps::Velocity = 1e-6

  variable s::Length
  variable v::Velocity
  variable a_long::Acceleration
  variable F_drag::Force
  variable F_roll_front::Force
  variable F_roll_rear::Force
  variable F_grade::Force
  variable F_traction_front::Force
  variable F_traction_rear::Force
  variable N_front::Force
  variable N_rear::Force
  variable N_static_front::Force
  variable N_static_rear::Force
  variable delta_N::Force

  relations
    contact_front.s_traction = s
    contact_rear.s_traction = s
    contact_front.s_normal = 0.0
    contact_rear.s_normal = 0.0
    F_traction_front = contact_front.f_traction
    F_traction_rear = contact_rear.f_traction
    v = der(s)
    a_long = der(v)
    N_static_front = m * g * cos(theta) * (b / L)
    N_static_rear = m * g * cos(theta) * (a / L)
    delta_N = m * a_long * h_cg / L
    N_front = N_static_front - delta_N
    N_rear = N_static_rear + delta_N
    F_drag = 0.5 * rho * Cd * A * v * abs(v)
    F_roll_front = Crr * N_front * (v / sqrt(v*v + v_eps*v_eps))
    F_roll_rear = Crr * N_rear * (v / sqrt(v*v + v_eps*v_eps))
    F_grade = m * g * sin(theta)
    m * a_long = F_traction_front + F_traction_rear - F_drag - F_roll_front - F_roll_rear - F_grade
    contact_front.f_normal = -N_front
    contact_rear.f_normal = -N_rear
  end

