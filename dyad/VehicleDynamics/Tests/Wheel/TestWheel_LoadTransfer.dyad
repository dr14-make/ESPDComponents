# Analyses for all three normal force levels
analysis TestWheel_LoadTransfer_3000N_Analysis
  extends TransientAnalysis(stop = 10.0, alg = "Rodas5P")
  model = TestWheel_LoadTransfer_3000N()
end

analysis TestWheel_LoadTransfer_5000N_Analysis
  extends TransientAnalysis(stop = 10.0, alg = "Rodas5P")
  model = TestWheel_LoadTransfer_5000N()
end

analysis TestWheel_LoadTransfer_7000N_Analysis
  extends TransientAnalysis(stop = 10.0, alg = "Rodas5P")
  model = TestWheel_LoadTransfer_7000N()
end
