# ============================================================================
# Wheel Component - Phase 1: Traction Limit + Kinematic Constraint
# ============================================================================
component Wheel
  flange_rot = Dyad.Spline() [{
    "Dyad": {"placement": {"diagram": {"iconName": "default", "x1": -60, "y1": 450, "x2": 40, "y2": 550, "rot": 0}}}
  }]
  contact = ESPDComponents.VehicleDynamics.Connectors.WheelContact() [{
    "Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 950, "y1": 450, "x2": 1050, "y2": 550, "rot": 0}}}
  }]
  
  parameter radius::Length = 0.3
  parameter mu::Real = 0.8
  parameter J::Inertia = 0.5
  
  variable omega::AngularVelocity
  variable N::Force
  variable F_max::Force
  variable F_desired::Force
  variable F_traction::Force
  
relations
  # Angular velocity
  omega = der(flange_rot.phi)
  
  # Kinematic constraint: rolling without slip (v = ω·r)
  # The connection determines contact.s_traction via body position
  # We enforce that the wheel angle follows: phi = s_traction / radius
  flange_rot.phi = contact.s_traction / radius
  
  # Normal force from body (per WheelContact.md documentation)
  N = -contact.f_normal
  
  # Traction limit based on normal force
  F_max = mu * N
  
  # Desired traction from input torque
  F_desired = flange_rot.tau / radius
  
  # Apply traction limit (smooth saturation)
  F_traction = F_max * tanh(F_desired / (F_max + 1e-6))
  
  # Output traction force
  contact.f_traction = F_traction
  
  # Rotational dynamics with kinematic constraint
  # With phi = s/r, we have: omega = v/r and alpha = a/r
  # Torque balance: J*alpha = tau - F*r
  # becomes: J*(a/r) = tau - F*r
  # rearranged: (J/r²)*a = (tau/r) - F
  # This adds effective mass m_eff = J/r² to the translational system
  # The torque creates an effective force: F_from_torque = tau/r
  # So the net equation is: F_traction = tau/r (which we already have via F_desired)
  # The rotational inertia effect appears as resistance to angular acceleration
  # which translates to resistance to linear acceleration
  
  # Since kinematic constraint eliminates one DOF, we don't need separate rotational dynamics
  # The wheel inertia contributes to the effective mass of the system
  

  # Fix normal position at ground
  contact.s_normal = 0.0
  
metadata {"Dyad": {"icons": {"default": "dyad://ESPDComponents/Wheel.svg"}}}
end
