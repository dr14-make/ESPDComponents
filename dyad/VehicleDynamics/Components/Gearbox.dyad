# ============================================================================
# Gearbox Component - Multi-Ratio Transmission with Reverse
# ============================================================================
#
# Description: Multi-ratio transmission with discrete gear selection
# Domain: Rotational mechanics
#
# Physics:
# - 6 forward gears + 1 reverse gear
# - Gear selection via integer input (R=0, 1, 2, 3, 4, 5, 6)
# - Speed ratio: ω_out = ω_in / ratio[gear]
# - Torque multiplication: τ_out = -τ_in × ratio[gear] × η[gear]
# - Efficiency losses per gear
# - Instant gear changes (Phase 1)
#
# Interface:
# - flange_in: Spline (input from engine)
# - flange_out: Spline (output to driveline)
# - gear_input: RealInput (gear selection: 0=R, 1-6=forward)
#
# Gear Convention:
# - gear_input = 0  → Reverse (negative ratio)
# - gear_input = 1  → 1st gear (highest ratio, max torque)
# - gear_input = 6  → 6th gear (overdrive, max speed)
# - gear_input < 0  → Defaults to Reverse
# - gear_input > 6  → Defaults to 6th gear
#
# Status: Phase 1 - 6-speed with reverse
# ============================================================================

component Gearbox
  flange_in = Spline()
  flange_out = Spline()
  gear_input = RealInput()
  
  # Gear configuration (6-speed + reverse)
  structural parameter N_gears::Integer = 6
  
  # Gear ratios array (low gears = high ratio = high torque, low speed)
  parameter ratios::Real[6] = [4.0, 2.5, 1.7, 1.2, 1.0, 0.8]
  parameter efficiencies::Real[6] = [0.95, 0.96, 0.97, 0.97, 0.97, 0.97]
  
  # Reverse gear (negative ratio = backward direction)
  parameter ratio_reverse::Real = -3.5
  parameter efficiency_reverse::Real = 0.94
  
  # Active gear state
  variable gear::Real           # Gear number from input (0=R, 1-6=forward)
  variable ratio::Real          # Active ratio (negative for reverse)
  variable eta::Real            # Active efficiency
  variable omega_in::AngularVelocity
  variable omega_out::AngularVelocity
relations
  # Read gear command and clamp to valid range [0, N_gears]
  # 0 = Reverse, 1-6 = Forward gears
  gear = ifelse(gear_input < 0.0, 0.0,
                ifelse(gear_input > N_gears, N_gears,
                       gear_input))
  
  # Lookup ratio based on gear
  # 0 → Reverse (negative ratio)
  # 1-6 → Forward gears (positive ratios)
  ratio = ifelse(gear < 0.5, ratio_reverse,
                 ifelse(gear < 1.5, ratios[1],
                        ifelse(gear < 2.5, ratios[2],
                               ifelse(gear < 3.5, ratios[3],
                                      ifelse(gear < 4.5, ratios[4],
                                             ifelse(gear < 5.5, ratios[5],
                                                    ratios[6]))))))
  
  # Lookup efficiency based on gear
  eta = ifelse(gear < 0.5, efficiency_reverse,
               ifelse(gear < 1.5, efficiencies[1],
                      ifelse(gear < 2.5, efficiencies[2],
                             ifelse(gear < 3.5, efficiencies[3],
                                    ifelse(gear < 4.5, efficiencies[4],
                                           ifelse(gear < 5.5, efficiencies[5],
                                                  efficiencies[6]))))))
  
  # Speed relationships
  omega_in = der(flange_in.phi)
  omega_out = der(flange_out.phi)
  
  # Kinematic constraint: output speed = input speed / ratio
  # For reverse (negative ratio), output rotates backward
  omega_out = omega_in / ratio
  
  # Torque balance with efficiency
  # For reverse, negative ratio gives proper backward torque
  flange_out.tau = -flange_in.tau * ratio * eta
metadata {"Dyad": {"icons": {"default": "dyad://ESPDComponents/Gearbox.svg"}}}
end
