# ============================================================================
# Test: Wheel vs WheelWithSlip Comparison - Realistic Scenario
# ============================================================================
#
# Objective: Compare kinematic (no-slip) vs slip wheel models in realistic driving
#
# Test Configuration:
# - Dry tarmac conditions (high friction, D=1.0)
# - Moderate torque ramp (600 N·m over 10s)
# - Torque stays below traction limit for most of simulation
# - Shows small, realistic slip development
#
# Expected Results:
# - Original Wheel: No slip, v = ω·r always
# - WheelWithSlip: Small slip (5-15%), realistic tire behavior
# - Very similar vehicle speeds (slip model slightly faster)
# - Both produce similar forces until traction limit
#
# ============================================================================

# Original Wheel (no-slip kinematic constraint)
test component TestWheel_NoSlip_DryTarmac
  wheel = ESPDComponents.VehicleDynamics.Components.Wheel(
    radius = 0.3,
    mu = 1.0,
    J = 0.5
  )
  
  breakout = ESPDComponents.VehicleDynamics.Connectors.WheelContactBreakout()
  
  torque_source = RotationalComponents.TorqueSource()
  torque_cmd = BlockComponents.Ramp(height=600.0, duration=10.0, start_time=0.0, offset=0.0)
  ground_rot = RotationalComponents.Fixed()
  
  body = TranslationalComponents.Mass(m = 800.0)
  damper = TranslationalComponents.Damper(d = 30.0)
  ground_trans = TranslationalComponents.Fixed()
  
  normal_force = TranslationalComponents.Force()
  normal_cmd = BlockComponents.Constant(k = 3000.0)
  ground_normal = TranslationalComponents.Fixed()
  
relations
  connect(wheel.contact, breakout.contact)
  
  connect(torque_cmd.y, torque_source.tau)
  connect(torque_source.spline, wheel.flange_rot)
  connect(torque_source.support, ground_rot.spline)
  
  connect(breakout.flange_traction, body.flange_a)
  connect(body.flange_b, damper.flange_a)
  connect(damper.flange_b, ground_trans.flange)
  
  connect(normal_cmd.y, normal_force.f)
  connect(normal_force.flange_a, breakout.flange_normal)
  connect(normal_force.flange_b, ground_normal.flange)
  
  initial wheel.flange_rot.phi = 0.0
  initial wheel.omega = 0.0
  initial body.s = 0.0
  
  guess wheel.F_traction = 0.0
  guess wheel.F_desired = 0.0
  guess wheel.N = 3000.0
end

analysis TestWheel_NoSlip_DryTarmac_Analysis
  extends TransientAnalysis(stop = 10.0, alg = "Rodas5P")
  model = TestWheel_NoSlip_DryTarmac()
end

# WheelWithSlip (Pacejka slip model)
test component TestWheelWithSlip_DryTarmac
  wheel = ESPDComponents.VehicleDynamics.Components.WheelWithSlip(
    radius = 0.3,
    J = 0.5,
    B = 10.0,
    C = 1.9,
    D = 1.0,
    E = 0.97
  )
  
  breakout = ESPDComponents.VehicleDynamics.Connectors.WheelContactBreakout()
  
  torque_source = RotationalComponents.TorqueSource()
  torque_cmd = BlockComponents.Ramp(height=600.0, duration=10.0, start_time=0.0, offset=0.0)
  ground_rot = RotationalComponents.Fixed()
  
  body = TranslationalComponents.Mass(m = 800.0)
  damper = TranslationalComponents.Damper(d = 30.0)
  ground_trans = TranslationalComponents.Fixed()
  
  normal_force = TranslationalComponents.Force()
  normal_cmd = BlockComponents.Constant(k = 3000.0)
  ground_normal = TranslationalComponents.Fixed()
  
relations
  connect(wheel.contact, breakout.contact)
  
  connect(torque_cmd.y, torque_source.tau)
  connect(torque_source.spline, wheel.flange_rot)
  connect(torque_source.support, ground_rot.spline)
  
  connect(breakout.flange_traction, body.flange_a)
  connect(body.flange_b, damper.flange_a)
  connect(damper.flange_b, ground_trans.flange)
  
  connect(normal_cmd.y, normal_force.f)
  connect(normal_force.flange_a, breakout.flange_normal)
  connect(normal_force.flange_b, ground_normal.flange)
  
  initial wheel.flange_rot.phi = 0.0
  initial wheel.omega = 0.0
  initial body.s = 0.0
  
  guess wheel.F_traction = 0.0
  guess wheel.kappa = 0.0
  guess wheel.N = 3000.0
end

analysis TestWheelWithSlip_DryTarmac_Analysis
  extends TransientAnalysis(stop = 10.0, alg = "Rodas5P")
  model = TestWheelWithSlip_DryTarmac()
end
